# Endereço do Qdrant publicado na porta 2222 da máquina OCI.
# Troque SEU_IP_OCI pelo IP público da sua instância.
QDRANT_URL=http://SEU_IP_OCI:2222

# Chave de API do Qdrant (opcional — só se você configurou QDRANT__SERVICE__API_KEY).
QDRANT_API_KEY=

# Nome da coleção usada nos exercícios.
COLECAO=documentos-ragestagio
